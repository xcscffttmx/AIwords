# Docker Compose 环境变量配置示例
# 使用方式：复制本文件为 .env，并按需填写真实配置
# 注意：.env 包含真实密钥时不要提交到 Git 仓库

# MySQL 配置
# 上线前必须替换为强随机密码，不要使用默认值
MYSQL_ROOT_PASSWORD=root123
DB_NAME=ai_wordbook
MYSQL_USER=wordbook
MYSQL_PASSWORD=wordbook123

# JWT 密钥
# 上线前必须替换为复杂随机字符串（例如 openssl rand -base64 48）
# 使用默认值会导致任何人都能伪造登录 Token
JWT_SECRET=please-change-this-jwt-secret

# 对外域名与 HTTPS
# DOMAIN：已解析到本服务器公网 IP 的域名，Caddy 会自动申请 HTTPS 证书
#         本地测试可留空（默认 localhost，使用内部自签证书）
# ACME_EMAIL：Let's Encrypt 证书通知邮箱，建议填写
DOMAIN=
ACME_EMAIL=

# AI API Keys
# 如不填写，后端会自动返回模拟数据，便于演示完整流程
# 想要真实释义时填入对应 Key 后重启 backend 即可，无需改代码
DEEPSEEK_API_KEY=
QIANWEN_API_KEY=
